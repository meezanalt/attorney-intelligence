# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=attorney_intelligence

# Firm branding (public)
NEXT_PUBLIC_FIRM_NAME=Harrow & Vance
NEXT_PUBLIC_FIRM_PRODUCT=Attorney Intelligence
NEXT_PUBLIC_FIRM_WEBSITE=harrowvance.demo

# Rate limiting
CHAT_IP_HASH_SECRET=change-me-to-a-long-random-string
CHAT_RATE_LIMIT_RPM=20

# Optional Upstash Redis (falls back to Mongo when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Atlas vector search (falls back to JS cosine similarity)
CHAT_VECTOR_SEARCH_ENABLED=false

# Optional discovery debug logs
CHAT_DISCOVERY_DEBUG=false
